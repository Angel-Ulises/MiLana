{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": true,
      "chatgpt/*": false,
      "claude/*": false
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/guias",
      "destination": "/aprende",
      "permanent": true
    },
    {
      "source": "/guias/aguinaldo-2026",
      "destination": "/aprende/aguinaldo-bruto-neto",
      "permanent": true
    },
    {
      "source": "/guias/bruto-neto-recibo",
      "destination": "/aprende/leer-recibo-nomina",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_embed/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/calculadoras/:slug",
      "has": [
        {
          "type": "query",
          "key": "embed",
          "value": "1"
        }
      ],
      "destination": "/_embed/calculadoras/:slug"
    }
  ]
}
